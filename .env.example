# ---------------------------------------------------------------------------
# VibeBin environment variables
# ---------------------------------------------------------------------------

# Your Neon Postgres connection string (expand "Pooled connection" on the
# Neon dashboard and copy it). When this is empty, VibeBin automatically
# falls back to an embedded local database so you can develop with zero setup.
DATABASE_URL=

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
