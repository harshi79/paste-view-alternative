# ---------------------------------------------------------------------------
# VibeBin environment variables
# ---------------------------------------------------------------------------

# Turso (libSQL) connection string. Get it from your Turso dashboard:
# https://turso.tech/app → Select your database → "Create Token" for the
# auth token, and copy the database URL.
TURSO_DATABASE_URL=

# Turso authentication token (required for remote databases).
TURSO_AUTH_TOKEN=

# Legacy Neon connection string (kept temporarily for rollback).
# Remove after confirming the Turso migration is successful.
# DATABASE_URL=

# REQUIRED. Secret used to sign user session and admin tokens. There is no
# default and no fallback: without a valid AUTH_SECRET (min 32 chars) the
# app refuses to sign or accept any session/admin token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin panel password. The panel is at /admin and only accepts this value.
# Pick something long; you can rotate it any time by changing the env var.
# DO NOT commit the real value to git.
ADMIN_PASSWORD=

# Resend API key for transactional email (recovery-email verification and
# email-based password recovery). Get one at https://resend.com/api-keys.
# REQUIRED for those flows — without it they are disabled (the rest of the
# app is unaffected). DO NOT commit real keys to git.
RESEND_API_KEY=

# Optional: sender address shown to recipients
# (default: VibeBin <onboarding@resend.dev>).
RESEND_FROM=

# Optional: Resend API base URL override (default: https://api.resend.com).
# Only needed for local testing against a mock server.
RESEND_API_URL=

# Giphy API key for GIF search in the rich editor's "Anime GIFs" tab.
# Get a free key at https://developers.giphy.com (login → Create an App).
# When unset, a public beta key is used (fine for small/development use).
GIPHY_API_KEY=
